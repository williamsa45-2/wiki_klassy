# Variables para docker compose (VPS). Copiar a .env en la raíz del repo y cambiar los valores.
# MONGO_URI NO va aquí: docker-compose.yml la fija al contenedor `mongo`.

# Nombre de la base de datos dentro del contenedor de Mongo.
MONGO_DB=wiki_klassy

# Dominio público (ej. wiki.tuempresa.com). Con valor => HTTPS automático con Caddy (DNS A apuntando al VPS).
# Vacío => HTTP por IP en PUERTO_WEB (sirve para una primera prueba, pero las contraseñas viajarían sin cifrar).
DOMINIO=

# Puerto del sitio sin dominio (80), o el local detrás de Caddy (8080).
PUERTO_WEB=80

# Dirección pública completa, ej. https://wiki.tuempresa.com (vacío en modo HTTP por IP: http://IP).
PUBLIC_URL=

# Obligatorio: genera uno con `openssl rand -hex 32`. Si lo cambias, todas las sesiones abiertas se cierran.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Tamaño máximo por archivo en MB. Si lo subes por encima de 50, sube también client_max_body_size en frontend/nginx.conf.
MAX_ARCHIVO_MB=50

# Opcional: con clave, el asistente usa Claude; sin ella usa la búsqueda local por palabras.
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-haiku-5-5
